# 本地站点地址（CMS OAuth 回调使用此地址）
PUBLIC_SITE_URL=http://localhost:4321

# GitHub OAuth App 参数，仅用于本地运行，不要提交真实值
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Trending 仅服务端使用；不要提交真实值
# Token 建议使用无额外仓库写权限的细粒度访问令牌
GITHUB_TRENDING_TOKEN=
# 内部采集端点密钥，至少 32 个随机字符
GITHUB_TRENDING_COLLECTION_SECRET=
# 本地可选；生产由 docker-compose 固定到持久卷
GITHUB_TRENDING_DB_PATH=
