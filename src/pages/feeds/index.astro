---
import { Icon } from "astro-icon/components";
import { getAllFeeds } from "@/config/feedsConfig";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const feeds = await getAllFeeds();
const loadedAt = new Date();
---

<MainGridLayout title="热点" description="聚合值得关注的开发者资讯与外部信息流。">
	<section class="flex w-full rounded-(--radius-large) overflow-hidden relative">
		<div class="card-base z-10 px-6 py-6 md:px-9 md:py-8 relative w-full">
			<header class="mb-8">
				<div class="flex items-center gap-3 mb-3">
					<div class="h-9 w-9 rounded-lg bg-(--primary) flex items-center justify-center text-white dark:text-black/70">
						<Icon is:inline name="material-symbols:trending-up" class="text-2xl" />
					</div>
					<h1 class="text-3xl font-bold text-neutral-900 dark:text-neutral-100">热点</h1>
				</div>
				<p class="text-base text-neutral-600 dark:text-neutral-400">
					服务端实时获取外部信息源，仅展示摘要和原文链接。
				</p>
			</header>

			<div class="space-y-8">
				{feeds.map((feed) => (
					<section aria-labelledby={`${feed.source.id}-title`}>
						<div class="flex flex-wrap items-center justify-between gap-3 mb-4">
							<div>
								<h2 id={`${feed.source.id}-title`} class="text-xl font-semibold text-neutral-900 dark:text-neutral-100">
									{feed.source.name}
								</h2>
								<p class="text-sm text-neutral-500 dark:text-neutral-400">
									{feed.stale ? "当前为缓存内容，来源暂时不可用" : feed.error ? "来源暂时不可用" : `更新于 ${new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Shanghai" }).format(new Date(feed.fetchedAt))}`}
								</p>
							</div>
							<a href={feed.source.url} target="_blank" rel="noopener noreferrer" class="btn-regular px-3 py-2 text-sm inline-flex items-center gap-1.5">
								查看源 <Icon is:inline name="material-symbols:arrow-outward-rounded" />
							</a>
						</div>

						{feed.items.length > 0 ? (
							<div class="grid gap-3">
								{feed.items.map((item) => (
									<article class="rounded-xl border border-(--line-divider) p-4 hover:border-(--primary) transition-colors">
										<a href={item.link} target="_blank" rel="noopener noreferrer" class="group">
											<h3 class="font-semibold text-neutral-900 dark:text-neutral-100 group-hover:text-(--primary) transition-colors">{item.title}</h3>
											{item.description && <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400 line-clamp-3">{item.description}</p>}
											{item.published && <time class="mt-3 block text-xs text-neutral-400 dark:text-neutral-500" datetime={item.published}>{item.published}</time>}
										</a>
									</article>
								))}
							</div>
						) : (
							<div class="rounded-xl border border-dashed border-(--line-divider) px-4 py-8 text-center text-sm text-neutral-500 dark:text-neutral-400">
								{feed.error ? "该来源暂时不可用，请稍后重试。" : "暂无可展示内容。"}
							</div>
						)}
					</section>
				))}
			</div>

			<p class="mt-8 text-xs text-neutral-400 dark:text-neutral-500">页面生成于 {new Intl.DateTimeFormat("zh-CN", { dateStyle: "medium", timeStyle: "short", timeZone: "Asia/Shanghai" }).format(loadedAt)}</p>
		</div>
	</section>
</MainGridLayout>
