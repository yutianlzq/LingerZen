---
import { Icon } from "astro-icon/components";
import type { TrendingRepositoryItem } from "@/lib/github-trending/query-service";
import { url } from "@/utils/url-utils";

interface Props {
	item: TrendingRepositoryItem;
	showDelta: boolean;
}

const { item, showDelta } = Astro.props;
const detailUrl = url(
	`/hotspots/github/${encodeURIComponent(item.ownerLogin)}/${encodeURIComponent(item.name)}/`,
);
const githubUrl = `https://github.com/${encodeURIComponent(item.ownerLogin)}/${encodeURIComponent(item.name)}`;
const updatedLabel =
	item.pushedAt?.slice(0, 10) ?? item.updatedAt?.slice(0, 10) ?? "未知";
const numberFormatter = new Intl.NumberFormat("zh-CN");
---

<article class="card-base rounded-(--radius-large) p-4 sm:p-5 flex gap-4" data-repository-card>
	<div class="w-11 shrink-0 text-center">
		<span class="inline-flex min-w-9 h-9 px-2 rounded-xl items-center justify-center bg-(--btn-regular-bg) text-(--primary) font-bold tabular-nums">#{item.rank}</span>
	</div>
	<div class="min-w-0 flex-1">
		<div class="flex flex-wrap items-center gap-2">
			<a href={detailUrl} class="font-bold text-lg text-neutral-900 dark:text-neutral-100 hover:text-(--primary) break-all transition-colors">
				{item.fullName}
			</a>
			{item.language && <span class="rounded-full px-2 py-0.5 text-xs bg-black/5 dark:bg-white/10 text-neutral-600 dark:text-neutral-300">{item.language}</span>}
			{item.isArchived && <span class="inline-flex items-center gap-1 rounded-full px-2 py-0.5 text-xs bg-amber-500/10 text-amber-700 dark:text-amber-300"><Icon is:inline name="material-symbols:archive-outline" /> 已归档</span>}
		</div>

		{item.description && <p class="mt-2 text-sm leading-6 text-neutral-600 dark:text-neutral-400">{item.description}</p>}

		{item.topics.length > 0 && (
			<div class="flex flex-wrap gap-1.5 mt-3" aria-label="Topics">
				{item.topics.slice(0, 6).map((topic) => (
					<span class="rounded-full px-2 py-1 text-xs bg-(--btn-regular-bg) text-neutral-600 dark:text-neutral-300">{topic}</span>
				))}
			</div>
		)}

		<div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-neutral-500 dark:text-neutral-400 tabular-nums">
			<span class="inline-flex items-center gap-1"><Icon is:inline name="material-symbols:star-rounded" class="text-amber-500" /> {numberFormatter.format(item.stars)}{showDelta && item.metricDelta > 0 && <strong class="text-emerald-700 dark:text-emerald-400">+{numberFormatter.format(item.metricDelta)}</strong>}</span>
			<span class="inline-flex items-center gap-1"><Icon is:inline name="material-symbols:fork-right-rounded" /> {numberFormatter.format(item.forks)}</span>
			<span class="inline-flex items-center gap-1"><Icon is:inline name="material-symbols:bug-report-outline" /> {numberFormatter.format(item.openIssues)}</span>
			<span class="inline-flex items-center gap-1"><Icon is:inline name="material-symbols:schedule-rounded" /> {updatedLabel}</span>
		</div>

		<div class="mt-4 flex flex-wrap gap-2">
			<a href={detailUrl} class="btn-regular px-3 py-2 text-sm inline-flex items-center gap-1.5">查看趋势 <Icon is:inline name="material-symbols:show-chart-rounded" /></a>
			{item.homepageUrl && <a href={item.homepageUrl} target="_blank" rel="noopener noreferrer" class="btn-regular px-3 py-2 text-sm inline-flex items-center gap-1.5">项目主页 <Icon is:inline name="material-symbols:arrow-outward-rounded" /></a>}
			<a href={githubUrl} target="_blank" rel="noopener noreferrer" class="btn-regular px-3 py-2 text-sm inline-flex items-center gap-1.5"><Icon is:inline name="fa7-brands:github" /> GitHub</a>
		</div>
	</div>
</article>
